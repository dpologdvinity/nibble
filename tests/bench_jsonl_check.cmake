# Runs `nibble bench ... --out <OUT>` and checks OUT holds N_LINES schema-valid JSON lines.
#   cmake -DCMD=<exe> -DARGS="a;b" -DOUT=<file> -DN_LINES=<n> -P bench_jsonl_check.cmake
file(REMOVE ${OUT})
execute_process(COMMAND ${CMD} ${ARGS} RESULT_VARIABLE rc OUTPUT_VARIABLE o ERROR_VARIABLE e)
if(NOT "${rc}" STREQUAL "0")
  message(FATAL_ERROR "exit '${rc}'\n${o}\n${e}")
endif()
file(STRINGS ${OUT} lines)
list(LENGTH lines n)
if(NOT n EQUAL N_LINES)
  message(FATAL_ERROR "expected ${N_LINES} lines, got ${n}")
endif()
set(num "-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?")
set(re "^\\{\"tool\":\"nibble\",\"commit\":\"[^\"]+\",\"kernels\":\"(avx2\\+fma\\+f16c(\\+avxvnni)?|scalar)\",\"model\":\"[^\"]+\",\"test\":\"(pp8|tg4|membw)\",\"threads\":[0-9]+,\"reps\":[0-9]+,\"median\":${num},\"min\":${num},\"max\":${num},\"unit\":\"(tok/s|GB/s)\",\"load1\":${num},\"date\":\"[0-9]+-[0-9]+-[0-9]+T[0-9:]+Z\"\\}$")
foreach(l IN LISTS lines)
  if(NOT l MATCHES "${re}")
    message(FATAL_ERROR "bad JSON line: ${l}")
  endif()
  string(JSON t ERROR_VARIABLE err GET "${l}" test)
  if(err)
    message(FATAL_ERROR "not valid JSON: ${l}")
  endif()
endforeach()
